POSTGRES_DB=kodocode
POSTGRES_USER=kodocode
POSTGRES_PASSWORD=troque-esta-senha-local
POSTGRES_PORT=55432
POSTGRES_BIND_ADDRESS=127.0.0.1

BACKEND_PORT=8080
BACKEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3001
SPRING_PROFILES_ACTIVE=dev
# Vazio usa o proxy same-origin /api do frontend (recomendado).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3001
KODO_JWT_SECRET=gere-um-segredo-aleatorio-com-no-minimo-32-caracteres

# Ative somente no primeiro provisionamento e desative depois.
KODO_BOOTSTRAP_ADMIN_ENABLED=false
KODO_BOOTSTRAP_ADMIN_NAME=
KODO_BOOTSTRAP_ADMIN_EMAIL=
KODO_BOOTSTRAP_ADMIN_PASSWORD=

# EmailJS (desabilitado por padrão; o contato continua sendo salvo sem o provedor).
KODO_EMAILJS_ENABLED=false
KODO_EMAILJS_NOTIFICATION_TO=contato@seudominio.com.br
KODO_EMAILJS_ENDPOINT=https://api.emailjs.com/api/v1.0/email/send
KODO_EMAILJS_SERVICE_ID=
KODO_EMAILJS_NOTIFICATION_TEMPLATE_ID=
KODO_EMAILJS_CONFIRMATION_TEMPLATE_ID=
KODO_EMAILJS_PUBLIC_KEY=
# Opcional; use se a autenticação por Private Key estiver habilitada no EmailJS.
KODO_EMAILJS_PRIVATE_KEY=
KODO_EMAILJS_MINIMUM_REQUEST_INTERVAL=1100ms
